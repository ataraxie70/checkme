{
  "name": "checkme",
  "private": true,
  "version": "0.1.0",
  "description": "CheckMe! - infrastructure de publication et de consultation de données officielles",
  "engines": { "node": ">=24.18 <25" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "lint": "node scripts/check-architecture.mjs",
    "architecture:test": "node scripts/check-architecture.mjs",
    "runtime:test": "node --test tests/runtime/*.test.mjs",
    "typecheck": "node scripts/typecheck-foundation.mjs",
    "test": "npm run architecture:test && npm run runtime:test",
    "build": "node scripts/build-foundation.mjs"
  }
}
